{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Mikaela VPN",
  "description": "__MSG_extDesc__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/off16.png", "32": "icons/off32.png", "48": "icons/off48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Mikaela VPN",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/off16.png", "32": "icons/off32.png", "48": "icons/off48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"]
}
